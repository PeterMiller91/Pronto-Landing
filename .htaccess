# Fallback, falls in Plesk das Dokumentenstammverzeichnis NICHT auf "public" gestellt wurde:
# Alles nach public/ umleiten und die internen Ordner sperren.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|database|storage)(/|$) - [F,L]
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<FilesMatch "^\.|\.(md|sql|sqlite|example\.php)$">
  Require all denied
</FilesMatch>
